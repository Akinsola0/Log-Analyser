# Supabase project the backend team provisions.
#
# Leave these blank and the app runs on demo auth: accounts are created and kept
# in your browser, so sign-up and sign-in work with no backend (see README).
#
# Fill them in and restart `npm run dev`, and the same screens render Supabase
# Auth UI against the real project instead — no code change needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
